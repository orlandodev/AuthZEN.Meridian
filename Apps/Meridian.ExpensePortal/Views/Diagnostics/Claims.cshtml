<h1>Claims (debug)</h1>
<p class="hint">Useful whenever role- or ownership-based UI isn't behaving as expected —
   check the actual claim types/values flowing through before assuming the bug
   is in your Razor markup.</p>

<div class="card">
    <p><strong>Name:</strong> @User.Identity?.Name</p>
    <p><strong>IsAuthenticated:</strong> @User.Identity?.IsAuthenticated</p>
    <table class="diagnostics-table">
        <thead><tr><th>Type</th><th>Value</th></tr></thead>
        <tbody>
        @foreach (var claim in User.Claims)
        {
            <tr><td>@claim.Type</td><td>@claim.Value</td></tr>
        }
        </tbody>
    </table>
</div>
