<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Apps\Meridian.ExpensePortal\Meridian.ExpensePortal.csproj" />
    <ProjectReference Include="..\..\Aspire\Meridian.ServiceDefaults\Meridian.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Authorization\AuthZen.Contracts\AuthZen.Contracts.csproj" />
    <!-- "PdpServiceAssembly" lets PdpApiFactory.cs disambiguate this
         assembly's Program class via `extern alias PdpServiceAssembly;` +
         `PdpServiceAssembly::Program`, since it collides unqualified with the
         top-level-statement Program classes in Meridian.ExpensePortal/Expenses.Api/etc.,
         also referenced by this project. -->
    <ProjectReference Include="..\..\Authorization\Meridian.Pdp.Service\Meridian.Pdp.Service.csproj">
      <Aliases>PdpServiceAssembly</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\Authorization\Meridian.Pdp.Core\Meridian.Pdp.Core.csproj" />
    <!-- Same Program-collision reason as PdpServiceAssembly above. -->
    <ProjectReference Include="..\..\Authorization\Meridian.Pdp.Opa\Meridian.Pdp.Opa.csproj">
      <Aliases>PdpOpaAssembly</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\Common\Meridian.DataAccess\Meridian.DataAccess.csproj" />
    <ProjectReference Include="..\..\Common\Meridian.Services\Meridian.Services.csproj" />
    <ProjectReference Include="..\..\Services\Meridian.Expenses.Api\Meridian.Expenses.Api.csproj" />
    <ProjectReference Include="..\..\Services\Meridian.Receipts.Api\Meridian.Receipts.Api.csproj" />
    <ProjectReference Include="..\..\Services\Meridian.Reporting.Api\Meridian.Reporting.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="Moq" />
  </ItemGroup>

</Project>